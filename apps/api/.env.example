# Safiri API environment. Copy to apps/api/.env and fill in. Never commit .env.
# Every secret the API will use is listed here; ones for later slices are marked.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Public pages, App Links and pay links are served from this origin (Slice 1).
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated web origins allowed to call the API. The mobile app does not need this.
CORS_ORIGINS=

# --- Supabase (Slice 0) -------------------------------------------------------------
# Local: printed by `npx supabase start`. Hosted: Project Settings > API.
SUPABASE_URL=http://127.0.0.1:54321
# Bypasses RLS. API only: never put this in the app or in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres for quotes, holds and payments, and the pg-boss job queue. Local default shown.
# Hosted: Project Settings > Database > Connection string, SESSION pooler (port 5432), not the
# transaction pooler: holds run in transactions and pg-boss needs a long-lived connection.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Signs guest hold tokens and one-tap pay links. Any long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HOLD_TOKEN_SECRET=
# Authentication > Hooks > Send SMS. Format: v1,whsec_<base64>. Must match supabase/config.toml env.
SEND_SMS_HOOK_SECRET=

# --- Africa's Talking SMS (Slice 0) ----------------------------------------------------
# Use AT_USERNAME=sandbox with the sandbox API key while testing. If both are empty in
# development, OTP texts are written to the API log instead of sent.
AT_USERNAME=
AT_API_KEY=
# Alphanumeric sender ID, once approved (paperwork track). Leave empty until then.
AT_SENDER_ID=

# --- Monitoring (Slice 0) --------------------------------------------------------------
SENTRY_DSN=
# Safiri support line shown with the emergency numbers in itineraries (2547XXXXXXXX).
SUPPORT_PHONE=
# true only behind a proxy you control (Fly, Render, nginx): rate limits then key on the real client IP
TRUST_PROXY=false

# --- M-Pesa Daraja (Slice 3a; sandbox first) -------------------------------------------
# From developer.safaricom.co.ke > My Apps. Sandbox test shortcode is 174379 with the
# Lipa na M-PESA Online passkey shown on the Daraja simulator page.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Public HTTPS origin Daraja calls back, e.g. https://abc.trycloudflare.com
# (locally: `cloudflared tunnel --url http://localhost:3000`). No trailing slash.
DARAJA_CALLBACK_BASE_URL=
# Random path segment so only Daraja (which knows the full URL) reaches the callback. Any
# long random string: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DARAJA_CALLBACK_SECRET=
# B2C payouts and refunds (Slice 5)
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SECURITY_CREDENTIAL=

# --- WhatsApp Cloud API (reminders from Slice 3b; provider requests in Slice 5) ---------
# Leave empty until Meta approves the business and the templates in PAPERWORK.md.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Android App Links (Slice 1) --------------------------------------------------------
# SHA-256 fingerprint(s) of the app signing key, comma-separated (from `eas credentials`).
ANDROID_CERT_SHA256=
# Package name in assetlinks.json and the Play Store link on web pages.
ANDROID_PACKAGE=ke.safiri.app
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ke.safiri.app
