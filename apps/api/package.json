{
  "name": "@safiri/api",
  "version": "0.1.0",
  "private": true,
  "description": "Safiri API: money, inventory, messaging and public web pages",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "photos:upload": "node --env-file-if-exists=.env scripts/upload-photos.js",
    "schema:refresh": "node scripts/refresh-schema-vocab.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@safiri/shared": "0.1.0",
    "@sentry/node": "^11.7.0",
    "@supabase/supabase-js": "^2.117.3",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
