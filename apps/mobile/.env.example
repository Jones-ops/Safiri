# Safiri app environment. Copy to apps/mobile/.env.
# EVERYTHING prefixed EXPO_PUBLIC_ IS SHIPPED INSIDE THE APP and readable by anyone.
# Only public values belong here: no service-role key, no Daraja or WhatsApp credentials.

# Supabase project URL and publishable (anon) key. Reads are protected by RLS.
# Local: printed by `npx supabase start`. On a phone, use your computer's LAN IP, not 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_KEY=

# The Safiri API (apps/api). On a phone, use your computer's LAN IP or a tunnel URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Crash reporting. A DSN is public by design.
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics. Only sends after the user ticks the analytics consent.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Build-time only (set as EAS secrets, not EXPO_PUBLIC_) ---
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# EAS_PROJECT_ID=

# --- Public web layer (Slice 1) ---
# Public site address, used for share links. Same origin as PUBLIC_BASE_URL in apps/api/.env.
EXPO_PUBLIC_WEB_URL=https://safiri.example
# Build-time only: the domain App Links verify against (no scheme). Set as an EAS env var.
# WEB_HOST=safiri.example

# --- Offline maps (Slice 4) ---
# MapLibre style for trip maps. Its tile provider must allow offline packs, or point at our
# own self-hosted Kenya extract. Default: OpenFreeMap (check its terms before launch).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
